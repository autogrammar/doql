{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doql.dev/contracts/nlp2doql/v1/doql-plan.schema.json",
  "title": "DoqlPlan v1",
  "type": "object",
  "required": ["contractVersion", "title", "blocks"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["selector", "properties"],
      "properties": {
        "selector": { "type": "string", "minLength": 1, "maxLength": 500 },
        "properties": {
          "type": "object",
          "propertyNames": { "minLength": 1, "maxLength": 200 },
          "additionalProperties": { "type": "string", "maxLength": 4000 }
        },
        "comment": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
